# ScoutPulse Environment Variables
# Copy this file to .env.local and fill in the values

# =============================================================================
# SUPABASE (Required)
# =============================================================================
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# =============================================================================
# APPLICATION (Required)
# =============================================================================
# The base URL of your application
# Development: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# PWA & PUSH NOTIFICATIONS (Optional)
# =============================================================================
# VAPID keys for push notifications
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# =============================================================================
# ANALYTICS (Optional)
# =============================================================================
# PostHog - For product analytics
# Get from: https://app.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key-here
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# =============================================================================
# ERROR MONITORING (Optional)
# =============================================================================
# Sentry - For error tracking
# Get from: https://sentry.io/settings/projects/
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn-here
SENTRY_AUTH_TOKEN=your-sentry-auth-token-here

# =============================================================================
# EMAIL (Optional)
# =============================================================================
# Resend - For transactional emails
# Get from: https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key-here

# =============================================================================
# BUILD & DEVELOPMENT (Optional)
# =============================================================================
# Disable Next.js telemetry (set to 1 to disable)
NEXT_TELEMETRY_DISABLED=0

# Enable bundle analysis (set to true to analyze)
ANALYZE=false

# Turbopack TLS certificates (if build fails with Google Fonts)
# NEXT_TURBOPACK_EXPERIMENTAL_USE_SYSTEM_TLS_CERTS=1

# =============================================================================
# NOTES
# =============================================================================
# - Never commit .env.local to version control
# - Required variables must be set for the app to run
# - Optional variables enable additional features
# - Restart dev server after changing environment variables
